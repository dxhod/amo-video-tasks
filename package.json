{
  "name": "amo-video-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "npm run dev -w @amo/web",
    "worker": "npm run dev -w @amo/worker",
    "build": "npm run build -w @amo/web && npm run build -w @amo/worker",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "cleanup": "tsx apps/worker/src/cleanup.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
